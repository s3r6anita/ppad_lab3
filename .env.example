COMPOSE_PROJECT_NAME=ppad_lab3

POSTGRES_DB=ppad_dwh
POSTGRES_USER=ppad_admin
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_PORT=15432

# Airflow metadata database (not the analytical warehouse)
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=replace_with_airflow_db_password

# Airflow application
AIRFLOW_IMAGE_NAME=apache/airflow:2.11.0-python3.12
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace_with_airflow_admin_password
AIRFLOW_FERNET_KEY=replace_with_generated_fernet_key
AIRFLOW_WEBSERVER_SECRET_KEY=replace_with_generated_webserver_secret

# STG loader database password
STG_LOADER_PASSWORD=replace_with_stg_loader_password

# GitHub API token, read-only access to public repositories
GITHUB_TOKEN=replace_with_github_token
